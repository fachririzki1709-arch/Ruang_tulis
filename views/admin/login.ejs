<!DOCTYPE html>
<html lang="id">
<head>
    <title>Login - CatBlog Admin</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container login-container card">
        <h2 style="text-align: center; color: var(--primary-green);">🐱 Login Admin</h2>
        <form action="/login" method="POST" class="admin-form">
            <label>Username</label>
            <input type="text" name="username" required>
            <label>Password</label>
            <input type="password" name="password" required>
            <button type="submit" class="btn-read" style="width: 100%; margin-top: 20px; border:none; cursor:pointer;">Masuk</button>
        </form>
    </div>
</body>
</html>